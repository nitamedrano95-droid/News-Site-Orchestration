# CMS Originaux - Environment Variables
# Copy to cms-nuevos.env and fill in real values

CMS_NAME=cms-nuevos
PORT=3000
DATABASE_URL=./data/cms-nuevos.db
REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=nexopress
MINIO_SECRET_KEY=nexopress123
MINIO_BUCKET=cms-news
MINIO_REGION=us-east-1
ENVIRONMENT=production

# ── Auth ──────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=change-me-32-chars-minimum-here-xxxx
ENGAGEMENT_WEBHOOK_SECRET=change-me-webhook-secret

# ── AI (OpenRouter) ───────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here
AI_MODEL=google/gemini-2.0-flash-exp

# ── Telegram ──────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Facebook ──────────────────────────────────────────────────
FB_APP_ID=
FB_APP_SECRET=

# ── External APIs ─────────────────────────────────────────────
NEWSAPI_KEY=
OPENWEATHER_API_KEY=
