                      "fill": "#5C667A",
                      "content": "— Jerome Powell, Presidente de la Reserva Federal",
                      "fontFamily": "Inter",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
