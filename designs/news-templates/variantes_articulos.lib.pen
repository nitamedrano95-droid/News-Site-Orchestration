                      "fill": "#5C667A",
                      "content": "— Jerome Powell, Presidente de la Reserva Federal",
                      "fontFamily": "Fira Sans",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
              ]
