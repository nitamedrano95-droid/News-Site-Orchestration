                      "fill": "#9CAAF0",
                      "content": "— Jerome Powell, Presidente de la Reserva Federal",
                      "fontFamily": "Playfair Display",
                      "fontSize": 13,
                      "fontWeight": "normal"
                    }
                  ]
                }
