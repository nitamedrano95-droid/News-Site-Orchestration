# Variables de entorno para el sistema de noticias

# === Ollama Cloud (provider LLM) ===
# Obtenla en https://ollama.com → Settings → API keys
# Este repo usa Ollama Pro (verificado con tests en vivo, jun 2026).
# Stack recomendado:
#   - Parafraseo: Kimi K2.6 (256K ctx, mejor redaccion editorial en espanol, ~23s/articulo)
#   - Supervisor: GLM-5.1 (202K ctx, JSON estricto, ~1s, ~20x mas barato que Kimi)
# Alternativas compatibles (mismo provider ollama):
#   - deepseek-v4-pro:cloud  (1M ctx, mejor razonamiento puro)
#   - minimax-m2.7:cloud     (coding/agente)
#   - qwen3.5:397b           (multilingue, mas lento ~3s)
# Tier-free (sin Pro): gpt-oss:120b, gemma4:31b, deepseek-v3.2, qwen3-coder:480b
# NOTA: gpt-oss con think:false tiene un quirk (consume tokens en "thinking"
# y deja content vacio si num_predict es bajo). Los modelos :cloud de pago
# respetan think:false sin ese bug.
OLLAMA_API_KEY=
PARAPHRASE_PROVIDER=ollama
PARAPHRASE_MODEL=kimi-k2.6:cloud
SUPERVISOR_PROVIDER=ollama
SUPERVISOR_MODEL=glm-5.1:cloud

# === OpenRouter (legacy, opcional) ===
# Se conserva por compatibilidad con pipelines viejos. Si esta vacio, las llamadas
# openrouter fallaran con un mensaje claro.
OPENROUTER_API_KEY=sk-or-...xxxx

# === Gemini (legacy, opcional) ===
# Usado por ai_multi_source_publish_flow.py como fallback del openrouter free.
# GEMINI_API_KEY=...

# APIs de Noticias
NEWSAPI_KEY=your_newsapi_key_here
GNEWS_API_KEY=your_gnews_api_key_here

# URL del sitio (para headers de OpenRouter)
SITE_URL=https://noticias-mexico.com

# Facebook - Token de Usuario de Larga Duración (requerido para generar page tokens)
# Get your token from: https://developers.facebook.com/tools/explorer/
LONG_LIVED_TOKENFB=YOUR_FACEBOOK_USER_TOKEN_HERE

# Facebook - Page Access Tokens (se generan automáticamente con scripts/update_fb_tokens.py)
# FB_TOKEN_RADIOCINCONOTICIAS=...
# FB_TOKEN_CENTRALMEXICO=...
# FB_TOKEN_TVMEXICO=...
# FB_TOKEN_CBNNOTICIAS=...
# FB_TOKEN_MEXICOINFORMADO=...
# FB_TOKEN_NODOINFORMATIVO=...
# FB_TOKEN_BITACORAURBANA=...
# FB_TOKEN_REPORTECENTRALMX=...
# FB_TOKEN_VERTICENOTICIAS=...
# FB_TOKEN_NOTICIASOBJETIVO=...

# Configuración opcional
# MAX_ARTICLES_PER_RUN=50
# MIN_WORDS=500
