{
  "name": "nexopress",
  "version": "1.0.0",
  "description": "NexoPress — sistema multi-sitio de publicación de noticias sobre Cloudflare Workers/Pages.",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "pkill -f wrangler || true",
    "dev": "wrangler pages dev ./public --port 8888 --proxy 8781",
    "worker": "wrangler dev src/index.js --port 8781",
    "start": "npm run worker & npm run dev",
    "deploy": "wrangler pages deploy ./public",
    "build": "echo 'Building static assets...'",
    "preview": "wrangler pages dev ./public --live-reload",
    "test": "node --test tests/e2e/api.test.js tests/e2e/og-tags.test.js tests/e2e/links.test.js",
    "test:api": "node --test tests/e2e/api.test.js",
    "test:og": "node --test tests/e2e/og-tags.test.js",
    "test:links": "node --test tests/e2e/links.test.js",
    "test:editor": "npx playwright test tests/e2e/editor.spec.js --config tests/playwright.config.js",
    "test:all": "npm test && npm run test:editor",
    "site:create": "node packages/site-builder/cli.mjs create",
    "site:validate": "node packages/site-builder/cli.mjs validate",
    "wizard": "cd deploy-wizard/wizard && node server.js"
  },
  "keywords": [
    "news",
    "website",
    "cloudflare",
    "pages",
    "workers",
    "frontend"
  ],
  "author": "News Website Team",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20230419.0",
    "typescript": "^5.0.4",
    "wrangler": "^4.75.0"
  },
  "dependencies": {
    "@openai/codex": "^0.104.0",
    "hono": "^4.0.0"
  }
}
